[Unit]
Description=Be Global Mini Apps API
After=network.target

[Service]
Type=simple
# Usuario dedicado sin privilegios (crear con: useradd -r -s /usr/sbin/nologin beglobal)
User=beglobal
Group=beglobal
WorkingDirectory=/srv/beglobal/miniapps/api
EnvironmentFile=/srv/beglobal/miniapps/api/.env
ExecStart=/srv/beglobal/miniapps/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=3

# Endurecimiento
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/beglobal/miniapps /srv/beglobal/mediahub
PrivateTmp=true

[Install]
WantedBy=multi-user.target
