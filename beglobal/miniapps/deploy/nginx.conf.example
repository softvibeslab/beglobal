# Mini Apps Be Global — requiere HTTPS (Telegram no abre Mini Apps sin TLS).
# Emitir certificado antes: certbot --nginx -d miniapps.TU-DOMINIO.com
server {
    listen 443 ssl http2;
    server_name miniapps.TU-DOMINIO.com;

    ssl_certificate     /etc/letsencrypt/live/miniapps.TU-DOMINIO.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/miniapps.TU-DOMINIO.com/privkey.pem;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 80;
    server_name miniapps.TU-DOMINIO.com;
    return 301 https://$host$request_uri;
}
