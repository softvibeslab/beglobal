# Tokens de bot por perfil (BotFather). NUNCA subir el .env real al repo.
MEMBER_BOT_TOKEN=
TEAM_BOT_TOKEN=
CORPORATE_BOT_TOKEN=

# Allowlist de user IDs de Telegram por perfil, separados por coma.
# Vacío = nadie entra (seguro por defecto).
MEMBER_ALLOWED_IDS=
TEAM_ALLOWED_IDS=
CORPORATE_ALLOWED_IDS=

# Rutas en el VPS
DB_PATH=/srv/beglobal/miniapps/beglobal.db
MEDIA_DIR=/srv/beglobal/mediahub
WEBAPP_DIR=/srv/beglobal/miniapps/webapp

# Seguridad
INITDATA_MAX_AGE=3600
MAX_UPLOAD_BYTES=20971520
# DEV_BYPASS=1  # SOLO desarrollo local. Jamás en el VPS.
